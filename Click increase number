
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <style>
    .button {
      text-align: center;
    }
  </style>
</head>
<body>
  <div class="text"></div>
  <div class="button">
    <button>Click Me</button>
  </div>
    <script>
  let btn = document.querySelector(".button button");
let counts = 1;
        btn.addEventListener("click",function(){
    document.querySelector(".text").textContent =  counts;
            counts++;
})
</script>  
</body>
</html>
